# Optional server-side quote delivery. Never use a VITE_ prefix.
# Configure both in Vercel, verify the sending domain in Resend, then redeploy.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
# Example sender after verification: Just Doors <quotes@your-verified-domain>
# Recipient is fixed in quote-handler.ts. Without configuration, email-draft fallback remains active.
